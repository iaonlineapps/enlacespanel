# Copia este archivo a .env y ajústalo (install.sh lo hace por ti la primera vez).

# Carpeta donde se guardan TODOS los datos (usuarios, páginas, fotos y estadísticas).
# En una Raspberry Pi conviene que esté en un disco externo, no en la tarjeta SD.
# Ejemplo: DATA_DIR=/mnt/disco/enlacespanel
DATA_DIR=./data

# Opcional: dirección pública del servidor si tienes dominio (por ejemplo https://enlaces.midominio.com).
# Se usa para los enlaces que compartes y los QR. También se puede poner en el panel: Ajustes → Servidor.
PUBLIC_URL=

# Puerto en el que se abre la web (http://IP-DE-TU-PI:8092)
PORT=8092

# Zona horaria (lista: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=Europe/Madrid

# UID/GID del usuario dueño de los archivos (mira el tuyo con: id -u ; id -g)
PUID=1000
PGID=1000

# Opcional: crea este administrador al arrancar si no existe.
# Si lo dejas vacío, el primer usuario que se registre será el administrador.
# Usa una contraseña larga y no subas nunca el archivo .env a GitHub.
ADMIN_USER=
ADMIN_PASSWORD=

# 1 = cualquiera puede pedir cuenta (el admin la aprueba); 0 = solo el admin crea cuentas
ALLOW_REGISTER=1

# Páginas por usuario y enlaces por página
MAX_PAGES=5
MAX_LINKS=100

# Días que se guardan las estadísticas (contadores por día, sin datos personales)
STATS_DAYS=400

# Para el aviso de privacidad (RGPD): quién es el responsable y un correo de contacto.
# Si vas a abrir el servidor a otras personas, rellénalo.
OWNER_NAME=
CONTACT_EMAIL=
